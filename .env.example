# Copier en .env (gitignoré) pour un déploiement à la main depuis la VM : sh k8s/deploy.sh
# En CI, ces valeurs viennent des secrets GitHub (Settings > Secrets and variables > Actions).
DB_ROOT_PASSWORD=changeme
DB_PASSWORD=changeme
ADMIN_PASSWORD=changeme
# optionnel : généré automatiquement s'il est vide
REDIS_PASSWORD=
# monitoring : si vide, Prometheus/Grafana ne sont pas installés
GRAFANA_ADMIN_PASSWORD=
